DATABASE_URL="postgresql://username:password@localhost:5432/mdpcare_db?schema=public"
REDIS_URL="redis://localhost:6379"
# NODE_ENV defaults to "production" when unset (fail-closed)
NODE_ENV=development
PORT=5000
# Comma-separated allow-list, e.g. "https://admin.mdpcare.in,https://app.mdpcare.in". "*" disables credentials.
CORS_ORIGIN="*"
# Number of reverse proxies in front of the app (0 locally, usually 1 behind nginx/ALB)
TRUST_PROXY=0

# JWT Configuration - REQUIRED, >= 32 chars each, must differ. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# JWT_ISSUER=mdpcare-api
# JWT_AUDIENCE=mdpcare-app

# Twilio Verify (required for real OTPs)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

OTP_EXPIRES_IN_MINUTES=5

# Development OTP - refused at boot when NODE_ENV=production
TEST_OTP_ENABLED=true
TEST_PHONE_NUMBER="+919812345678"
TEST_OTP_CODE="123456"

# Booking matching (business decision Q3)
BOOKING_ROUND_RADII_KM=3,6,10
BOOKING_ROUND_TIMEOUT_SECONDS=60
BOOKING_MAX_CANDIDATES_PER_ROUND=25
BOOKING_SWEEP_INTERVAL_SECONDS=10
BOOKING_COMPLETION_OTP_TTL_MINUTES=240
# BOOKING_OTP_PEPPER=""          # optional; defaults to a key derived from JWT_ACCESS_SECRET
# BOOKING_WORKERS_ENABLED=false  # disable the expiry sweeper (scripts/tests)

# Provider live location: app sends every 30 s, kept in Redis,
# saved to the database every 10 min; search ignores locations older than 15 min
PROVIDER_LOCATION_DB_SAVE_SECONDS=600
PROVIDER_LOCATION_STALE_SECONDS=900

// =====================================================
// Customer rating after a job (NEW)
// =====================================================

/// A customer's rating after a COMPLETED booking. One review per booking.
/// Rating must be 1 to 5 (checked by the database too).
model Review {
  id Int @id @default(autoincrement())

  bookingId Int     @unique // one review per booking
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  customerId Int
  customer   User @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Who did the job. For an individual booking only providerId is set.
  // For an agency booking agencyId is set (and staffMemberId if known).
  providerId    Int?
  provider      ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  agencyId      Int?
  agency        Agency?          @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  staffMemberId Int?
  staffMember   AgencyMember?    @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)

  rating  Int // 1 = very bad ... 5 = excellent
  comment String?

  isVisible Boolean @default(true) // admin can hide abusive reviews

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId, createdAt])
  @@index([agencyId, createdAt])
  @@index([staffMemberId])
  @@index([customerId])
}

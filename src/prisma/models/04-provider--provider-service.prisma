// =====================================================
// Services an individual provider does
// =====================================================

/// Which admin services an individual provider can do.
model ProviderService {
  id Int @id @default(autoincrement())

  providerId Int
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // NOT USED: the admin sets every price on Service.
  // Kept only because removing a column is a destructive change.
  customPrice Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, serviceId])
  @@index([serviceId, isActive])
  @@index([providerId, isActive])
}

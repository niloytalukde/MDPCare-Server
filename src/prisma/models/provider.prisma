enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProviderAvailabilityStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum ProviderVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum ProviderDocumentType {
  PROFILE_PHOTO
  ID_PROOF
  ADDRESS_PROOF
  CERTIFICATE
  LICENSE
  OTHER
}

model ProviderProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Professional information
  displayName     String?
  bio             String?
  experienceYears Int     @default(0)

  // Provider approval
  status             ProviderStatus             @default(PENDING)
  verificationStatus ProviderVerificationStatus @default(NOT_SUBMITTED)
  rejectionReason    String?
  verifiedAt         DateTime?
  approvedAt         DateTime?

  // Availability
  availabilityStatus ProviderAvailabilityStatus @default(OFFLINE)
  isAvailable        Boolean                    @default(false)

  // Live location
  latitude          Decimal?  @db.Decimal(10, 7)
  longitude         Decimal?  @db.Decimal(10, 7)
  locationUpdatedAt DateTime?
  serviceRadiusKm   Int       @default(10)

  // Professional statistics
  averageRating     Decimal @default(0) @db.Decimal(3, 2)
  totalReviews      Int     @default(0)
  totalBookings     Int     @default(0)
  completedBookings Int     @default(0)
  cancelledBookings Int     @default(0)

  // Payment information
  bankAccountVerified Boolean @default(false)

  // Relations
  services     ProviderService[]
  documents    ProviderDocument[]
  availability ProviderAvailability[]

  bookings        Booking[]
  bookingRequests BookingProvider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availabilityStatus, isAvailable])
  @@index([latitude, longitude])
  @@index([verificationStatus])
}

model ProviderService {
  id Int @id @default(autoincrement())

  providerId Int
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // Provider-specific pricing
  customPrice Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, serviceId])
  @@index([serviceId, isActive])
  @@index([providerId, isActive])
}

model ProviderDocument {
  id Int @id @default(autoincrement())

  providerId Int
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  type           ProviderDocumentType
  documentUrl    String
  documentNumber String?

  verificationStatus ProviderVerificationStatus @default(PENDING)
  rejectionReason    String?
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId, type])
}

model ProviderAvailability {
  id Int @id @default(autoincrement())

  providerId Int
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // 0 = Sunday, 1 = Monday ... 6 = Saturday
  dayOfWeek Int

  startTime String // Example: "09:00"
  endTime   String // Example: "18:00"

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId, dayOfWeek, isActive])
}

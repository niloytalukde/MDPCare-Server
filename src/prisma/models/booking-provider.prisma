model BookingProvider {
  id Int @id @default(autoincrement())

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  providerId Int
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)

  searchRound Int
  distanceKm  Decimal @db.Decimal(8, 3)

  status BookingRequestStatus @default(SENT)

  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, providerId])
  @@index([providerId, status])
  @@index([bookingId, searchRound])
}

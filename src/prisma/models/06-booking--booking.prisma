// =====================================================
// The booking (order) itself
// =====================================================

enum BookingStatus {
  PENDING
  SEARCHING_PROVIDER
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum BookingType {
  INSTANT
  SCHEDULED
}

/// One customer order. Belongs to EITHER one provider OR one agency, never both.
model Booking {
  id            Int    @id @default(autoincrement())
  bookingNumber String @unique

  // Customer
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Assigned provider
  providerId Int?
  provider   ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  // Booking type and status
  type   BookingType   @default(INSTANT)
  status BookingStatus @default(PENDING)

  // Address snapshot
  addressId Int?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  addressLabel String?
  fullAddress  String
  latitude     Decimal @db.Decimal(10, 7)
  longitude    Decimal @db.Decimal(10, 7)
  landmark     String?

  // Payment snapshot
  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(PENDING)
  paidAt        DateTime?

  paymentReference String?

  // Agency
  agencyId Int?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  // Agency booking requests
  agencyRequests BookingAgency[]

  // Assigned agency staff
  agencyAssignment  AgencyBookingAssignment?
  assignmentHistory AgencyAssignmentHistory[]

  // Family member
  familyMemberId Int?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  customerName   String?
  customerPhone  String?

  // Schedule
  scheduledAt       DateTime?
  timezone          String    @default("Asia/Kolkata")
  estimatedDuration Int?

  // Price snapshots
  currency       String  @default("INR")
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  platformFee    Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  // Provider matching
  searchRadius       Int       @default(3)
  broadcastRound     Int       @default(0)
  broadcastStartedAt DateTime?
  expiresAt          DateTime?

  // Acceptance and service lifecycle
  acceptedAt       DateTime?
  serviceStartedAt DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?

  // Relations
  items            BookingItem[]
  providerRequests BookingProvider[]
  broadcastRounds  BookingBroadcastRound[]
  otpVerifications BookingOTP[]
  statusHistory    BookingStatusHistory[]
  cancellation     BookingCancellation?

  // Ledger postings referencing this booking
  walletTransactions       WalletTransaction[]
  agencyWalletTransactions AgencyWalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ----- Added for the full platform -----
  payments       Payment[]
  refunds        Refund[]
  review         Review?
  notifications  Notification[]
  supportTickets SupportTicket[]

  @@index([userId, createdAt])
  @@index([providerId, status])
  @@index([status, expiresAt])
  @@index([status, scheduledAt])
  @@index([latitude, longitude])
  @@index([agencyId, status])
  @@index([addressId])
  @@index([familyMemberId])
}

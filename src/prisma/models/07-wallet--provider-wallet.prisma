// =====================================================
// Individual provider wallet
// =====================================================

/// Money balance of an individual provider.
model ProviderWallet {
  id         Int             @id @default(autoincrement())
  providerId Int             @unique
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)

  balance        Decimal @default(0) @db.Decimal(14, 2)
  pendingBalance Decimal @default(0) @db.Decimal(14, 2)
  totalEarnings  Decimal @default(0) @db.Decimal(14, 2)
  totalWithdrawn Decimal @default(0) @db.Decimal(14, 2)

  transactions WalletTransaction[]
  payouts      WalletPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One money movement in a provider wallet (never edited, only added).
model WalletTransaction {
  id       Int            @id @default(autoincrement())
  walletId Int
  wallet   ProviderWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type   WalletTransactionType
  reason WalletTransactionReason
  status WalletTransactionStatus @default(PENDING)

  amount        Decimal  @db.Decimal(14, 2)
  balanceBefore Decimal? @db.Decimal(14, 2)
  balanceAfter  Decimal? @db.Decimal(14, 2)

  bookingId   Int?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  referenceId String?  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId, createdAt])
  @@index([bookingId])
  @@index([status])
}

/// A provider's request to withdraw money to their bank.
model WalletPayout {
  id       Int            @id @default(autoincrement())
  walletId Int
  wallet   ProviderWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  amount Decimal      @db.Decimal(14, 2)
  status PayoutStatus @default(PENDING)

  bankReference    String?
  paymentReference String?
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([walletId, status])
}

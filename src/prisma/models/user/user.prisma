enum AccountStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UserRoleType {
  CUSTOMER
  PROVIDER
  ADMIN
  SUPPORT
}

model UserRole {
  id     Int          @id @default(autoincrement())
  userId Int
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   UserRoleType

  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([role])
}

model User {
  id              Int              @id @default(autoincrement())
  email           String?          @unique
  name            String?
  phone           String           @unique
  gender          String?
  location        Address[]
  familyMembers   FamilyMember[]
  accountStatus   AccountStatus    @default(ACTIVE)
  bookings        Booking[]
  providerProfile ProviderProfile?
  isPhoneVerified Boolean          @default(false)
  isEmailVerified Boolean          @default(false)
  fcmToken        String?
  deviceImei      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
}

// =====================================================
// Services an agency and its staff do
// =====================================================

/// Which admin services an agency can do.
model AgencyService {
  id Int @id @default(autoincrement())

  agencyId Int
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // NOT USED: the admin sets every price on Service.
  // Kept only because removing a column is a destructive change.
  customPrice Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, serviceId])
  @@index([serviceId, isActive])
  @@index([agencyId, isActive])
}

/// Which services each staff member is trained for.
model AgencyStaffService {
  id Int @id @default(autoincrement())

  agencyMemberId Int
  agencyMember   AgencyMember @relation(fields: [agencyMemberId], references: [id], onDelete: Cascade)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyMemberId, serviceId])
  @@index([serviceId, isActive])
}
